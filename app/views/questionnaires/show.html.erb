<div class="min-h-screen bg-base-200 flex items-center justify-center p-4">
  <div class="card w-full max-w-2xl bg-base-100 shadow-xl">
    <div class="card-body">
      <h1 class="card-title text-3xl mb-2"><%= @questionnaire.title %></h1>

      <% if @questionnaire.description.present? %>
        <p class="text-base-content/70 mb-6"><%= @questionnaire.description %></p>
      <% end %>

      <% if flash[:alert] %>
        <div class="alert alert-error mb-4">
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <%= form_with url: start_questionnaire_path(@questionnaire.unique_token), method: :post, class: "space-y-4", data: { controller: "loading" } do |f| %>
        <div class="form-control">
          <label class="label">
            <span class="label-text font-semibold">Your Name</span>
          </label>
          <%= text_field_tag :employee_name, nil, class: "input input-bordered w-full", placeholder: "Enter your name", required: true %>
        </div>

        <div class="card-actions justify-end mt-6">
          <%= f.submit "Start Questionnaire", class: "btn btn-primary btn-lg w-full", data: { loading_target: "submit" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="space-y-4">
  <div class="alert alert-info">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <span>Character Sheet allows users to distribute points across multiple attributes to build a "character sheet" representing their work style, skills, or preferences.</span>
  </div>

  <%# Total Points Budget %>
  <div class="form-control">
    <%= f.label :settings_total_points, "Total Points Budget", class: "label" %>
    <%= f.number_field :settings_total_points,
                       value: @question.settings["total_points"] || 20,
                       min: 10,
                       max: 100,
                       class: "input input-bordered w-full" %>
    <div class="label">
      <span class="label-text-alt">Total points users can allocate across all stats (10-100)</span>
    </div>
  </div>

  <%# Stats Configuration %>
  <div class="form-control">
    <%= f.label :settings_stats, "Stats (JSON Array)", class: "label" %>
    <%= f.text_area :settings_stats,
                    value: (@question.settings["stats"] || [
                      { id: "leadership", label: "Leadership", description: "Ability to guide and inspire others", min: 0, max: 10 },
                      { id: "technical", label: "Technical Skills", description: "Coding and system design", min: 0, max: 10 },
                      { id: "creative", label: "Creativity", description: "Innovative thinking", min: 0, max: 10 },
                      { id: "communication", label: "Communication", description: "Written and verbal skills", min: 0, max: 10 }
                    ]).to_json,
                    class: "textarea textarea-bordered h-64 font-mono text-sm",
                    placeholder: '[{"id":"leadership","label":"Leadership","description":"...","min":0,"max":10}]' %>
    <div class="label">
      <span class="label-text-alt">JSON array of stats (3-10 stats). Each must have: id, label, description, min, max.</span>
    </div>
  </div>

  <%# Require Full Allocation %>
  <div class="form-control">
    <label class="label cursor-pointer justify-start gap-4">
      <%= f.check_box :settings_require_full_allocation,
                      { checked: @question.settings.fetch("require_full_allocation", true), class: "checkbox checkbox-primary" },
                      true,
                      false %>
      <span class="label-text">Require full allocation (users must allocate all points)</span>
    </label>
  </div>

  <%# Format Helper %>
  <div class="card bg-base-200">
    <div class="card-body">
      <h3 class="card-title text-sm">Format Example:</h3>
      <pre class="text-xs overflow-x-auto"><code>[
  {
    "id": "leadership",
    "label": "Leadership",
    "description": "Ability to guide and inspire others",
    "min": 0,
    "max": 10
  },
  {
    "id": "technical",
    "label": "Technical Skills",
    "description": "Coding and system design",
    "min": 0,
    "max": 10
  }
]</code></pre>
    </div>
  </div>

  <%# Common Character Sheet Examples %>
  <div class="card bg-base-200">
    <div class="card-body">
      <h3 class="card-title text-sm">Common Use Cases:</h3>
      <div class="space-y-2 text-sm">
        <p><strong>Work Style:</strong> Leadership, Technical, Creative, Communication, Analytical</p>
        <p><strong>Team Role:</strong> Planning, Execution, Innovation, Support, Coordination</p>
        <p><strong>Skills Assessment:</strong> Frontend, Backend, DevOps, Design, Product</p>
        <p><strong>Preferences:</strong> Solo Work, Collaboration, Mentoring, Learning, Teaching</p>
        <p><strong>RPG-Style:</strong> Strength, Intelligence, Charisma, Wisdom, Dexterity</p>
      </div>
    </div>
  </div>

  <%# Validation Rules %>
  <div class="alert alert-warning">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div>
      <p class="font-bold">Validation Requirements:</p>
      <ul class="list-disc list-inside text-sm">
        <li>Total points must be between 10 and 100</li>
        <li>Must have between 3 and 10 stats</li>
        <li>Each stat must have unique "id"</li>
        <li>Each stat must have "id", "label", and "description"</li>
        <li>Optional: "min" and "max" (defaults: 0 and 10)</li>
        <li>Total points cannot exceed sum of all stat maximums</li>
      </ul>
    </div>
  </div>

  <%# Design Tips %>
  <div class="card bg-base-200">
    <div class="card-body">
      <h3 class="card-title text-sm">Design Tips:</h3>
      <ul class="list-disc list-inside text-sm space-y-1">
        <li>Use 15-25 total points for quick allocation (1-2 minutes)</li>
        <li>Use 40-60 points for thoughtful allocation (5-10 minutes)</li>
        <li>Keep stat maximums consistent (e.g., all max=10) for easier comparison</li>
        <li>Use descriptive labels and clear descriptions</li>
        <li>Consider 4-6 stats for optimal user experience</li>
      </ul>
    </div>
  </div>
</div>

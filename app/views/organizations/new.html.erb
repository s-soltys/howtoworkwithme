<div class="container mx-auto px-4 py-8">
  <div class="card max-w-md mx-auto bg-base-100 shadow-xl">
    <div class="card-body">
      <h1 class="card-title text-3xl mb-4">Create Organization</h1>

      <%= form_with model: @organization, local: true, class: "space-y-4" do |f| %>
        <% if @organization.errors.any? %>
          <div class="alert alert-error">
            <ul>
              <% @organization.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-control">
          <%= f.label :name, class: "label" do %>
            <span class="label-text">Organization Name</span>
          <% end %>
          <%= f.text_field :name, class: "input input-bordered w-full", placeholder: "e.g., Acme Corp" %>
        </div>

        <div class="card-actions justify-end">
          <%= f.submit "Create Organization", class: "btn btn-primary btn-lg w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

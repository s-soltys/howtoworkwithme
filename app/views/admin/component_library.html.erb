<div class="container mx-auto px-4 py-8">
  <h1 class="text-4xl font-bold mb-8">DaisyUI Component Library</h1>

  <!-- Buttons Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Buttons</h2>
    <div class="flex flex-wrap gap-2">
      <button class="btn">Default</button>
      <button class="btn btn-primary">Primary</button>
      <button class="btn btn-secondary">Secondary</button>
      <button class="btn btn-accent">Accent</button>
      <button class="btn btn-info">Info</button>
      <button class="btn btn-success">Success</button>
      <button class="btn btn-warning">Warning</button>
      <button class="btn btn-error">Error</button>
      <button class="btn btn-ghost">Ghost</button>
      <button class="btn btn-link">Link</button>
      <button class="btn btn-outline">Outline</button>
      <button class="btn btn-disabled" disabled>Disabled</button>
    </div>
    <div class="flex flex-wrap gap-2 mt-4">
      <button class="btn btn-lg">Large</button>
      <button class="btn">Normal</button>
      <button class="btn btn-sm">Small</button>
      <button class="btn btn-xs">Tiny</button>
    </div>
  </section>

  <!-- Alerts Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Alerts</h2>
    <div class="space-y-4">
      <div role="alert" class="alert">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Default alert message</span>
      </div>
      <div role="alert" class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Info alert message</span>
      </div>
      <div role="alert" class="alert alert-success">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Success alert message</span>
      </div>
      <div role="alert" class="alert alert-warning">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        <span>Warning alert message</span>
      </div>
      <div role="alert" class="alert alert-error">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Error alert message</span>
      </div>
    </div>
  </section>

  <!-- Cards Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Cards</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title">Card Title</h2>
          <p>This is a basic card with shadow.</p>
          <div class="card-actions justify-end">
            <button class="btn btn-primary">Action</button>
          </div>
        </div>
      </div>
      <div class="card bg-primary text-primary-content">
        <div class="card-body">
          <h2 class="card-title">Primary Card</h2>
          <p>Card with primary color background.</p>
          <div class="card-actions justify-end">
            <button class="btn">Action</button>
          </div>
        </div>
      </div>
      <div class="card bg-base-100 shadow-xl">
        <figure class="px-10 pt-10">
          <div class="w-full h-32 bg-base-300 rounded-xl flex items-center justify-center">
            <span class="text-base-content/50">Image Placeholder</span>
          </div>
        </figure>
        <div class="card-body items-center text-center">
          <h2 class="card-title">Card with Image</h2>
          <p>Card featuring an image at the top.</p>
          <div class="card-actions">
            <button class="btn btn-primary">Action</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Badges Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Badges</h2>
    <div class="flex flex-wrap gap-2">
      <div class="badge">Default</div>
      <div class="badge badge-primary">Primary</div>
      <div class="badge badge-secondary">Secondary</div>
      <div class="badge badge-accent">Accent</div>
      <div class="badge badge-info">Info</div>
      <div class="badge badge-success">Success</div>
      <div class="badge badge-warning">Warning</div>
      <div class="badge badge-error">Error</div>
      <div class="badge badge-ghost">Ghost</div>
      <div class="badge badge-outline">Outline</div>
    </div>
    <div class="flex flex-wrap gap-2 mt-4">
      <div class="badge badge-lg">Large</div>
      <div class="badge badge-md">Medium</div>
      <div class="badge badge-sm">Small</div>
      <div class="badge badge-xs">Tiny</div>
    </div>
  </section>

  <!-- Form Inputs Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Form Inputs</h2>
    <div class="space-y-4 max-w-md">
      <div class="form-control w-full">
        <label class="label">
          <span class="label-text">Text Input</span>
        </label>
        <input type="text" placeholder="Type here" class="input input-bordered w-full" />
      </div>
      <div class="form-control w-full">
        <label class="label">
          <span class="label-text">Primary Input</span>
        </label>
        <input type="text" placeholder="Type here" class="input input-bordered input-primary w-full" />
      </div>
      <div class="form-control w-full">
        <label class="label">
          <span class="label-text">Select</span>
        </label>
        <select class="select select-bordered w-full">
          <option disabled selected>Pick one</option>
          <option>Option 1</option>
          <option>Option 2</option>
          <option>Option 3</option>
        </select>
      </div>
      <div class="form-control w-full">
        <label class="label">
          <span class="label-text">Textarea</span>
        </label>
        <textarea class="textarea textarea-bordered h-24" placeholder="Enter text"></textarea>
      </div>
      <div class="form-control">
        <label class="label cursor-pointer">
          <span class="label-text">Checkbox</span>
          <input type="checkbox" class="checkbox" />
        </label>
      </div>
      <div class="form-control">
        <label class="label cursor-pointer">
          <span class="label-text">Toggle</span>
          <input type="checkbox" class="toggle" checked />
        </label>
      </div>
      <div class="form-control">
        <label class="label cursor-pointer">
          <span class="label-text">Radio Button</span>
          <input type="radio" name="radio-demo" class="radio" checked />
        </label>
      </div>
    </div>
  </section>

  <!-- Loading Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Loading Spinners</h2>
    <div class="flex flex-wrap gap-4">
      <span class="loading loading-spinner loading-xs"></span>
      <span class="loading loading-spinner loading-sm"></span>
      <span class="loading loading-spinner loading-md"></span>
      <span class="loading loading-spinner loading-lg"></span>
    </div>
    <div class="flex flex-wrap gap-4 mt-4">
      <span class="loading loading-dots loading-xs"></span>
      <span class="loading loading-dots loading-sm"></span>
      <span class="loading loading-dots loading-md"></span>
      <span class="loading loading-dots loading-lg"></span>
    </div>
    <div class="flex flex-wrap gap-4 mt-4">
      <span class="loading loading-ring loading-xs"></span>
      <span class="loading loading-ring loading-sm"></span>
      <span class="loading loading-ring loading-md"></span>
      <span class="loading loading-ring loading-lg"></span>
    </div>
  </section>

  <!-- Progress Bars Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Progress Bars</h2>
    <div class="space-y-4">
      <progress class="progress w-full" value="0" max="100"></progress>
      <progress class="progress w-full" value="25" max="100"></progress>
      <progress class="progress w-full" value="50" max="100"></progress>
      <progress class="progress w-full" value="75" max="100"></progress>
      <progress class="progress w-full" value="100" max="100"></progress>
    </div>
    <div class="space-y-4 mt-4">
      <progress class="progress progress-primary w-full" value="70" max="100"></progress>
      <progress class="progress progress-secondary w-full" value="70" max="100"></progress>
      <progress class="progress progress-accent w-full" value="70" max="100"></progress>
      <progress class="progress progress-info w-full" value="70" max="100"></progress>
      <progress class="progress progress-success w-full" value="70" max="100"></progress>
      <progress class="progress progress-warning w-full" value="70" max="100"></progress>
      <progress class="progress progress-error w-full" value="70" max="100"></progress>
    </div>
  </section>

  <!-- Modal Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Modal</h2>
    <button class="btn" onclick="modal_demo.showModal()">Open Modal</button>
    <dialog id="modal_demo" class="modal">
      <div class="modal-box">
        <h3 class="font-bold text-lg">Hello!</h3>
        <p class="py-4">This is a DaisyUI modal component. Press ESC key or click the button below to close.</p>
        <div class="modal-action">
          <form method="dialog">
            <button class="btn">Close</button>
          </form>
        </div>
      </div>
    </dialog>
  </section>

  <!-- Toast/Notification Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Toast Notifications</h2>
    <div class="toast toast-start">
      <div class="alert alert-info">
        <span>Toast notification start position</span>
      </div>
    </div>
    <div class="toast toast-end">
      <div class="alert alert-success">
        <span>Toast notification end position</span>
      </div>
    </div>
  </section>

  <!-- Tabs Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Tabs</h2>
    <div role="tablist" class="tabs tabs-bordered">
      <input type="radio" name="tabs_demo" role="tab" class="tab" aria-label="Tab 1" checked />
      <div role="tabpanel" class="tab-content p-6">
        <p>Content for Tab 1</p>
      </div>
      <input type="radio" name="tabs_demo" role="tab" class="tab" aria-label="Tab 2" />
      <div role="tabpanel" class="tab-content p-6">
        <p>Content for Tab 2</p>
      </div>
      <input type="radio" name="tabs_demo" role="tab" class="tab" aria-label="Tab 3" />
      <div role="tabpanel" class="tab-content p-6">
        <p>Content for Tab 3</p>
      </div>
    </div>
  </section>

  <!-- Collapse/Accordion Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Collapse/Accordion</h2>
    <div class="space-y-2">
      <div class="collapse collapse-arrow bg-base-200">
        <input type="radio" name="accordion_demo" checked />
        <div class="collapse-title text-xl font-medium">
          Accordion Item 1
        </div>
        <div class="collapse-content">
          <p>Content for accordion item 1</p>
        </div>
      </div>
      <div class="collapse collapse-arrow bg-base-200">
        <input type="radio" name="accordion_demo" />
        <div class="collapse-title text-xl font-medium">
          Accordion Item 2
        </div>
        <div class="collapse-content">
          <p>Content for accordion item 2</p>
        </div>
      </div>
      <div class="collapse collapse-arrow bg-base-200">
        <input type="radio" name="accordion_demo" />
        <div class="collapse-title text-xl font-medium">
          Accordion Item 3
        </div>
        <div class="collapse-content">
          <p>Content for accordion item 3</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Breadcrumbs Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Breadcrumbs</h2>
    <div class="text-sm breadcrumbs">
      <ul>
        <li><a>Home</a></li>
        <li><a>Documents</a></li>
        <li>Component Library</li>
      </ul>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Stats</h2>
    <div class="stats shadow">
      <div class="stat">
        <div class="stat-title">Total Page Views</div>
        <div class="stat-value">89,400</div>
        <div class="stat-desc">21% more than last month</div>
      </div>
      <div class="stat">
        <div class="stat-title">Total Users</div>
        <div class="stat-value">5,231</div>
        <div class="stat-desc">12% more than last month</div>
      </div>
      <div class="stat">
        <div class="stat-title">New Registers</div>
        <div class="stat-value">1,254</div>
        <div class="stat-desc">8% more than last month</div>
      </div>
    </div>
  </section>

  <!-- Divider Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Divider</h2>
    <div class="flex flex-col w-full">
      <div class="divider">OR</div>
      <div class="divider divider-primary">PRIMARY</div>
      <div class="divider divider-secondary">SECONDARY</div>
      <div class="divider divider-accent">ACCENT</div>
    </div>
  </section>

  <!-- Menu Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Menu</h2>
    <ul class="menu bg-base-200 w-56 rounded-box">
      <li><a>Item 1</a></li>
      <li><a>Item 2</a></li>
      <li>
        <details open>
          <summary>Parent Item</summary>
          <ul>
            <li><a>Submenu 1</a></li>
            <li><a>Submenu 2</a></li>
          </ul>
        </details>
      </li>
      <li><a>Item 3</a></li>
    </ul>
  </section>

</div>


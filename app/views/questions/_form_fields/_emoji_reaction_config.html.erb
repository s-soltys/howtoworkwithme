<div class="space-y-4">
  <div class="alert alert-info">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <span>Emoji Reaction allows users to express immediate emotional or intuitive responses using emoji selection.</span>
  </div>

  <%# Emoji Options %>
  <div class="form-control">
    <%= f.label :settings_emoji_options, "Emoji Options (JSON Array)", class: "label" %>
    <%= f.text_area :settings_emoji_options,
                    value: (@question.settings["emoji_options"] || [
                      { emoji: "😍", label: "Love it", value: 5 },
                      { emoji: "😊", label: "Like it", value: 4 },
                      { emoji: "😐", label: "Neutral", value: 3 },
                      { emoji: "😕", label: "Dislike", value: 2 },
                      { emoji: "😤", label: "Hate it", value: 1 }
                    ]).to_json,
                    class: "textarea textarea-bordered h-48 font-mono text-sm",
                    placeholder: '[{"emoji":"😍","label":"Love it","value":5},{"emoji":"😊","label":"Like it","value":4}]' %>
    <div class="label">
      <span class="label-text-alt">JSON array of emoji options (3-10 options). Each must have: emoji, label, and optional numeric value.</span>
    </div>
  </div>

  <%# Format Helper %>
  <div class="card bg-base-200">
    <div class="card-body">
      <h3 class="card-title text-sm">Format Example:</h3>
      <pre class="text-xs overflow-x-auto"><code>[
  {
    "emoji": "😍",
    "label": "Love it",
    "value": 5
  },
  {
    "emoji": "😊",
    "label": "Like it",
    "value": 4
  },
  {
    "emoji": "😐",
    "label": "Neutral",
    "value": 3
  }
]</code></pre>
    </div>
  </div>

  <%# Common Emoji Sets %>
  <div class="card bg-base-200">
    <div class="card-body">
      <h3 class="card-title text-sm">Common Emoji Sets:</h3>
      <div class="space-y-2 text-sm">
        <p><strong>Sentiment (5-point):</strong> 😍 😊 😐 😕 😤</p>
        <p><strong>Agreement:</strong> 👍 👎 🤷</p>
        <p><strong>Energy Levels:</strong> 🔥 💪 😊 😴 🥱</p>
        <p><strong>Mood:</strong> 😄 😊 😐 😔 😢</p>
        <p><strong>Stress Levels:</strong> 😌 🙂 😬 😰 😱</p>
        <p><strong>Work Style:</strong> 🧠 💡 🎨 📊 🛠️</p>
      </div>
    </div>
  </div>

  <%# Validation Rules %>
  <div class="alert alert-warning">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div>
      <p class="font-bold">Validation Requirements:</p>
      <ul class="list-disc list-inside text-sm">
        <li>Must have between 3 and 10 emoji options</li>
        <li>Each emoji must be unique</li>
        <li>Each option must have "emoji" and "label" fields</li>
        <li>"value" field is optional (for numerical analysis)</li>
      </ul>
    </div>
  </div>
</div>

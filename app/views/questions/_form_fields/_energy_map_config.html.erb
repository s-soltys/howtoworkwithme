<div class="space-y-4">
  <div class="alert alert-info">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <span>Energy Map allows users to plot energy/mood levels across different time periods using an interactive draggable graph.</span>
  </div>

  <%# Time Periods %>
  <div class="form-control">
    <%= f.label :settings_time_periods, "Time Periods (one per line)", class: "label" %>
    <%= f.text_area :settings_time_periods,
                    value: (@question.settings["time_periods"] || ["Morning", "Midday", "Afternoon", "Evening"]).join("\n"),
                    class: "textarea textarea-bordered h-32",
                    placeholder: "Monday Morning\nMonday Afternoon\nTuesday Morning\nTuesday Afternoon" %>
    <div class="label">
      <span class="label-text-alt">Enter 3-24 time periods, one per line (e.g., days of week, hours of day, project phases)</span>
    </div>
  </div>

  <%# Scale Min %>
  <div class="form-control">
    <%= f.label :settings_scale_min, "Minimum Scale Value", class: "label" %>
    <%= f.number_field :settings_scale_min,
                       value: @question.settings["scale_min"] || 0,
                       class: "input input-bordered w-full" %>
    <div class="label">
      <span class="label-text-alt">Lowest value on the Y-axis (e.g., 0 for "Exhausted")</span>
    </div>
  </div>

  <%# Scale Max %>
  <div class="form-control">
    <%= f.label :settings_scale_max, "Maximum Scale Value", class: "label" %>
    <%= f.number_field :settings_scale_max,
                       value: @question.settings["scale_max"] || 10,
                       class: "input input-bordered w-full" %>
    <div class="label">
      <span class="label-text-alt">Highest value on the Y-axis (e.g., 10 for "Energized")</span>
    </div>
  </div>

  <%# Y-Axis Label %>
  <div class="form-control">
    <%= f.label :settings_y_axis_label, "Y-Axis Label", class: "label" %>
    <%= f.text_field :settings_y_axis_label,
                     value: @question.settings["y_axis_label"] || "Energy Level",
                     class: "input input-bordered w-full",
                     placeholder: "Energy Level, Mood, Engagement, etc." %>
    <div class="label">
      <span class="label-text-alt">Label for the Y-axis (what you're measuring)</span>
    </div>
  </div>

  <%# Scale Labels (Optional) %>
  <div class="form-control">
    <%= f.label :settings_scale_labels, "Scale Labels (JSON - Optional)", class: "label" %>
    <%= f.text_area :settings_scale_labels,
                    value: (@question.settings["scale_labels"] || { 0 => "Exhausted", 5 => "Moderate", 10 => "Energized" }).to_json,
                    class: "textarea textarea-bordered",
                    placeholder: '{"0": "Exhausted", "5": "Moderate", "10": "Energized"}' %>
    <div class="label">
      <span class="label-text-alt">Optional: Semantic labels for scale values (JSON format)</span>
    </div>
  </div>

  <%# Allow Partial Completion %>
  <div class="form-control">
    <label class="label cursor-pointer justify-start gap-4">
      <%= f.check_box :settings_allow_partial,
                      { checked: @question.settings.fetch("allow_partial", true), class: "checkbox checkbox-primary" },
                      true,
                      false %>
      <span class="label-text">Allow partial completion (users can leave some periods empty)</span>
    </label>
  </div>

  <%# Preview Example %>
  <div class="card bg-base-200">
    <div class="card-body">
      <h3 class="card-title text-sm">Preview Example:</h3>
      <p class="text-sm">Users will see a line chart with draggable points. They can drag points up/down to indicate their energy level at each time period.</p>
      <p class="text-sm mt-2">Example: "Map your energy levels throughout a typical work week"</p>
    </div>
  </div>
</div>

<div class="space-y-4">
  <div class="alert alert-info">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    <span>Configure the cards that users will rank. Minimum 3 cards, maximum 15 cards.</span>
  </div>

  <div class="form-control">
    <%= label_tag 'question_settings_cards', "Cards (JSON)", class: "label" %>
    <%= text_area_tag 'question[settings][cards]',
                      (@question.settings["cards"] || [
                        { id: "card-1", text: "Work-life balance" },
                        { id: "card-2", text: "Career growth" },
                        { id: "card-3", text: "Compensation" },
                        { id: "card-4", text: "Team culture" }
                      ]).to_json,
                      class: "textarea textarea-bordered font-mono text-sm",
                      rows: 12,
                      required: true %>
    <div class="label">
      <span class="label-text-alt">
        Array of card objects. Each card must have "id" and "text". Optional "description" field.
      </span>
    </div>
  </div>

  <div class="collapse collapse-arrow bg-base-200">
    <input type="checkbox" />
    <div class="collapse-title font-medium">
      Example Format
    </div>
    <div class="collapse-content">
      <pre class="text-xs bg-base-300 p-4 rounded-lg overflow-x-auto"><code>[
  {
    "id": "card-1",
    "text": "Work-life balance",
    "description": "Time for personal life and hobbies"
  },
  {
    "id": "card-2",
    "text": "Career growth",
    "description": "Opportunities for advancement"
  },
  {
    "id": "card-3",
    "text": "Compensation"
  }
]</code></pre>
    </div>
  </div>

  <div class="form-control">
    <label class="label cursor-pointer">
      <span class="label-text">Allow Partial Ranking</span>
      <%= check_box_tag 'question[settings][allow_partial_ranking]',
                        '1',
                        @question.settings["allow_partial_ranking"] != false,
                        class: "checkbox checkbox-primary" %>
    </label>
    <div class="label">
      <span class="label-text-alt">If enabled, users can leave some cards unranked</span>
    </div>
  </div>
</div>

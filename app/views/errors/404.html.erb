<div class="min-h-screen flex items-center justify-center bg-base-200">
  <div class="card w-96 bg-base-100 shadow-xl">
    <div class="card-body items-center text-center">
      <h2 class="card-title text-4xl">404</h2>
      <p class="text-xl font-semibold">Page Not Found</p>
      <p class="text-base-content/70">The page or resource you're looking for doesn't exist or may have been removed.</p>

      <div class="card-actions justify-center mt-4">
        <%= link_to "Go Back", "javascript:history.back()", class: "btn btn-primary" %>
      </div>
    </div>
  </div>
</div>

<div class="space-y-4">
  <div class="alert alert-info">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    <span>All settings are optional. Swipe yes/no questions use the same data field as regular yes/no questions but with a fun swipe interaction.</span>
  </div>

  <div class="form-control">
    <%= label_tag 'question_settings_positive_label', "Positive Label (optional)", class: "label" %>
    <%= text_field_tag 'question[settings][positive_label]',
                       @question.settings["positive_label"] || 'Yes',
                       class: "input input-bordered",
                       placeholder: "Yes" %>
    <div class="label">
      <span class="label-text-alt">Label shown when swiping right (default: "Yes")</span>
    </div>
  </div>

  <div class="form-control">
    <%= label_tag 'question_settings_negative_label', "Negative Label (optional)", class: "label" %>
    <%= text_field_tag 'question[settings][negative_label]',
                       @question.settings["negative_label"] || 'No',
                       class: "input input-bordered",
                       placeholder: "No" %>
    <div class="label">
      <span class="label-text-alt">Label shown when swiping left (default: "No")</span>
    </div>
  </div>

  <div class="form-control">
    <%= label_tag 'question_settings_swipe_threshold', "Swipe Threshold (optional)", class: "label" %>
    <%= number_field_tag 'question[settings][swipe_threshold]',
                         @question.settings["swipe_threshold"] || 0.3,
                         class: "input input-bordered",
                         min: 0.1,
                         max: 0.9,
                         step: 0.1,
                         placeholder: "0.3" %>
    <div class="label">
      <span class="label-text-alt">Percentage of screen width needed to register swipe (0.1-0.9, default: 0.3)</span>
    </div>
  </div>

  <div class="form-control">
    <%= label_tag 'question_settings_animation_duration', "Animation Duration (ms, optional)", class: "label" %>
    <%= number_field_tag 'question[settings][animation_duration]',
                         @question.settings["animation_duration"] || 300,
                         class: "input input-bordered",
                         min: 100,
                         max: 1000,
                         step: 50,
                         placeholder: "300" %>
    <div class="label">
      <span class="label-text-alt">Duration of swipe animations in milliseconds (default: 300ms)</span>
    </div>
  </div>
</div>

<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-4xl font-bold">Configure Questionnaire</h1>
    <% if flash[:notice] %>
      <div class="alert alert-success mt-4">
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="alert alert-warning mt-4">
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>
    <% if @questionnaire.locked? %>
      <div class="alert alert-warning mt-4">
        <span>This questionnaire is locked and cannot be edited because employees have already submitted responses.</span>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl mb-4"><%= @questionnaire.title %></h2>
          <p class="text-gray-600 mb-6"><%= @questionnaire.description %></p>

          <div id="employee_link_display" class="mb-6">
            <%= render "questionnaires/employee_link", questionnaire: @questionnaire %>
          </div>

          <div class="divider"></div>

          <h3 class="text-xl font-semibold mb-4">Categories & Questions</h3>

          <% unless @questionnaire.locked? %>
            <div class="mb-4">
              <%= form_with url: questionnaire_categories_path(@questionnaire.unique_token), method: :post, class: "flex gap-2" do |f| %>
                <%= f.text_field :name, placeholder: "Category name", class: "input input-bordered flex-1" %>
                <%= f.submit "Add Category", class: "btn btn-primary" %>
              <% end %>
            </div>
          <% end %>

          <div id="categories_list" class="space-y-4">
            <% @categories.each do |category| %>
              <%= render "categories/category_with_questions", category: category, locked: @questionnaire.locked? %>
            <% end %>

            <% if @categories.empty? %>
              <div class="alert">
                <span>No categories yet. Add one to get started!</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-1">
      <div class="card bg-base-100 shadow-xl sticky top-4">
        <div class="card-body">
          <h3 class="card-title">Actions</h3>
          <div class="space-y-2">
            <%= link_to "View Responses", responses_questionnaire_path(@questionnaire.unique_token), class: "btn btn-outline w-full" %>
            <%= link_to "Back to Dashboard", organization_path(@questionnaire.organization.unique_token), class: "btn btn-ghost w-full" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
